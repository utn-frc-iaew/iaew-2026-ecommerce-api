{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "backgroundColor": {
            "type": "string"
          },
          "textColor": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "content",
          "backgroundColor",
          "textColor"
        ]
      }
    },
    "version": {
      "type": "string"
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "latestVersion": {
      "type": "string"
    },
    "catalog": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "filePath": {
          "type": "string"
        },
        "publicPath": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "filePath",
        "publicPath",
        "type"
      ]
    },
    "$schema": {
      "type": "string"
    }
  }
}