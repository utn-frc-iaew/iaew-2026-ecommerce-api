{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string"
    },
    "schemaId": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "file": {
      "type": "string"
    },
    "filePath": {
      "type": "string"
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default": {
      "type": "boolean"
    },
    "latest": {
      "type": "boolean"
    },
    "message": {
      "type": "object",
      "properties": {
        "collectionName": {
          "type": "string",
          "enum": [
            "events",
            "commands",
            "queries"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "collectionName",
        "id",
        "version"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "provider"
      ]
    },
    "readOnly": {
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "draft": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "message"
          ]
        }
      ]
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "backgroundColor": {
            "type": "string"
          },
          "textColor": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "content",
          "backgroundColor",
          "textColor"
        ]
      }
    },
    "owners": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "collection": {
                "type": "string",
                "enum": [
                  "users",
                  "teams"
                ]
              }
            },
            "required": [
              "id",
              "collection"
            ]
          }
        ]
      }
    },
    "schemaPath": {
      "type": "string"
    },
    "specifications": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "openapiPath": {
              "type": "string"
            },
            "asyncapiPath": {
              "type": "string"
            },
            "graphqlPath": {
              "type": "string"
            }
          }
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "openapi",
                  "asyncapi",
                  "graphql"
                ]
              },
              "path": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "type",
              "path"
            ]
          }
        }
      ]
    },
    "sidebar": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "badge": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "backgroundColor": {
          "type": "string"
        }
      }
    },
    "repository": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "hidden": {
      "type": "boolean"
    },
    "editUrl": {
      "type": "string"
    },
    "resourceGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "version": {
                  "default": "latest",
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "agent",
                    "service",
                    "event",
                    "command",
                    "query",
                    "flow",
                    "channel",
                    "domain",
                    "user",
                    "team",
                    "container"
                  ]
                }
              },
              "required": [
                "id",
                "type"
              ]
            }
          },
          "limit": {
            "default": 10,
            "type": "number"
          },
          "sidebar": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "items"
        ]
      }
    },
    "styles": {
      "type": "object",
      "properties": {
        "icon": {
          "type": "string"
        },
        "node": {
          "type": "object",
          "properties": {
            "color": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          }
        }
      }
    },
    "deprecated": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "string",
                  "format": "date-time"
                }
              ]
            }
          }
        },
        {
          "type": "boolean"
        }
      ]
    },
    "visualiser": {
      "type": "boolean"
    },
    "attachments": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "format": "uri"
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "title": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              }
            },
            "required": [
              "url"
            ]
          }
        ]
      }
    },
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "default": "latest",
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "latestVersion": {
      "type": "string"
    },
    "catalog": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "filePath": {
          "type": "string"
        },
        "publicPath": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "filePath",
        "publicPath",
        "type"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "format",
    "message",
    "source",
    "id",
    "name",
    "version"
  ]
}