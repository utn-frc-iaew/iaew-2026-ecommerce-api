{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "sidebar": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "order": {
          "type": "number"
        }
      },
      "required": [
        "label",
        "order"
      ]
    },
    "owners": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "collection": {
                "type": "string",
                "enum": [
                  "users",
                  "teams"
                ]
              }
            },
            "required": [
              "id",
              "collection"
            ]
          }
        ]
      }
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "backgroundColor": {
            "type": "string"
          },
          "textColor": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "content",
          "backgroundColor",
          "textColor"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "summary"
  ]
}