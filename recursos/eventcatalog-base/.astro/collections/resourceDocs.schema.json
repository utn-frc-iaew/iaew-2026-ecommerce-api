{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "backgroundColor": {
            "type": "string"
          },
          "textColor": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "content",
          "backgroundColor",
          "textColor"
        ]
      }
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "hidden": {
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  }
}