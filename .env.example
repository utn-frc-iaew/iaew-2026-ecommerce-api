PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/iaew_ecommerce
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_AUDIENCE=https://iaew-pedidos-api
INTERNAL_API_KEY=colocar-api-key-local
RABBIT_URL=amqp://iaew:iaew-local@localhost:5672
RABBIT_USER=iaew
RABBIT_PASS=iaew-local
RETRY_DELAY_MS=3000
MAX_RETRIES=3
# Cantidad de intentos que fallan transitoriamente por evento (0 desactiva la simulacion).
SIMULATE_TRANSIENT_FAILURES=0

